# Điền trên máy của bạn. Không gửi token lên chat hoặc commit vào Git.
DISCORD_USER_TOKEN=
CHAMBER_BOT_ID=
# Kênh blackjack và điểm danh của server Valorant bạn đã cung cấp.
CHANNEL_ID=1135209450144272504
DAILY_CHANNEL_ID=1135209424538062858

# Martingale: thua x2; thắng về gốc; hòa/hoàn tiền giữ mức.
BETTING_MODE=martingale
WIN_BET_SEQUENCE=1,2,3,5
BASE_BET=1
# Gốc 1: 1 -> 2 -> 4 -> 8 -> 16 -> 32; thua 32 về 1, hòa giữ 32.
MARTINGALE_RESET_AT=32
MAX_BET=50
MAX_LOSS_STREAK=0
# Mỗi ván cách nhau ít nhất 15 giây, tính từ khi ván trước kết thúc.
ROUND_DELAY_SECONDS=15
ACTION_DELAY_MS=1500
# Giãn tất cả lệnh/nút ít nhất 5 giây, kể cả ví/điểm danh lúc mở phiên.
INTERACTION_GAP_SECONDS=5
RESPONSE_TIMEOUT_SECONDS=30
# Chờ bài cập nhật lâu hơn xác nhận nút; không tự gửi lại nút hoặc cược.
BOARD_UPDATE_TIMEOUT_SECONDS=75
# Kiểm tra ví đầu phiên, sau điểm danh và mỗi 50 ván; 0 tắt định kỳ.
WALLET_EVERY_ROUNDS=50
# Hết hạn thì giữ ước tính; không gửi lại ngay, không cập nhật ví từ phản hồi muộn.
WALLET_TIMEOUT_SECONDS=20

DAILY_ENABLED=true
DAILY_TIME=00:05
TIMEZONE=Asia/Ho_Chi_Minh
DAILY_COMMAND=diemdanh
ACCOUNT_COMMAND=taikhoan
BLACKJACK_COMMAND=blackjack
MONEY_OPTION=money

# Mô hình Át khớp mẫu Chamber: hai lá đầu chọn 1/11; Át rút thêm tính 1.
# initial_two = mô hình mới; draw_time = mô hình cũ; standard = blackjack chuẩn.
ACE_RULE=initial_two
# Hai cờ dưới là giả định mô hình, không phải luật server đã được xác minh.
DEALER_HITS_SOFT_17=false
DEALER_PEEK=false
# Luật quan sát từ log, chưa phải mã nguồn/luật RNG đã được xác minh.
DEALER_STAND_ON=16
BOTH_BUST_PUSH=true
NATURAL_WIN_MULTIPLIER=2
